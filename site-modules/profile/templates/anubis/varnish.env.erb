# File managed by puppet (profile::anubis), changes will be overwritten

BIND=<%= @bind_address %>:<%= @bind_port %>
DIFFICULTY=4
METRICS_BIND=<%= @actual_metrics_listen_address %>:<%= @metrics_listen_port %>
SERVE_ROBOTS_TXT=0
TARGET=http://<%= @target_address %>:<%= @target_port %>
POLICY_FNAME=/etc/anubis/varnish.botPolicies.yaml
