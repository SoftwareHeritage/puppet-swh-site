# Varnish configuration file
# File managed by puppet (module profile::varnish)
# All modifications will be lost.

probe internal_probe {
    .request = "GET /.well-known/varnish-probe HTTP/1.1"
    "Host: varnish-probe.internal"
    "X-Real-Ip: ::1"
    "User-Agent: varnish internal probe"
    "Connection: close";
}

backend self {
    .host = "<%= @anubis_backend_listen %>";
    .port = "<%= @anubis_backend_port %>";
    .probe = internal_probe;
}

backend anubis {
    .host = "<%= @anubis_listen_host %>";
    .port = "<%= @anubis_listen_port %>";
    .probe = internal_probe;
}

sub vcl_init {
    new self_behind_anubis = directors.fallback();
    self_behind_anubis.add_backend(anubis);
    self_behind_anubis.add_backend(self);
}

sub vcl_recv {
    if (req.url == "/.well-known/varnish-probe") {
        return (synth(200, "Varnish probed"));
    }
}
