# vhost_<%= @servername %>.vcl
#
# Settings for the <%= @servername %> vhost
#
# File managed by puppet. All modifications will be lost.

<%- if @allowed_networks -%>
acl allowed_networks_<%= @backend_name %> {
    <%- @allowed_networks.each do |network| %>
    <%= network %>;
    <% end -%>
}
<%- end -%>

sub vcl_recv {
    if (
<% @aliases.each do |alias_| -%>
        req.http.host == "<%= alias_.downcase %>" ||
<% end -%>
        req.http.host == "<%= @servername.downcase %>"
    ) {
        var.set("known-vhost", "yes");
        var.set("current-vhost", "<%= @backend_name %>");
    }

    if (var.get("current-vhost") == "<%= @backend_name %>") {
        if (std.port(server.ip) == <%= scope['::profile::varnish::http_port'] %>) {
            set req.http.x-redir = "https://" + req.http.host + req.url;
            return(synth(850, "Moved permanently"));
        }
<%- if scope['::profile::varnish::enable_anubis'] %>
        if (local.socket != "<%= scope['::profile::varnish::anubis_socket_name'] %>") {
            call set_ip_headers;
            set req.backend_hint = self_behind_anubis.backend();
            return (pipe);
        } else {
            set req.backend_hint = <%= @backend_name %>;
            call clean_ip_headers;
        }
<%- else %>
        call set_ip_headers;
        set req.backend_hint = <%= @backend_name %>;
<%- end -%>

<%- if @allowed_networks -%>
        if (client.ip !~ allowed_networks_<%= @backend_name %>) {
            return(synth(403, "Access denied"));
        }
<%- end -%>

<%- if @basic_auth %>
        if ( 1 == 1  # noop expression to be syntactically correct with the following &&
    <%- @basic_auth_strings.each do | basic_auth_string | %>
                && ! req.http.Authorization ~ "Basic <%= basic_auth_string %>"
    <%- end %>
        ) {
                return(synth(401, "Restricted"));
    }

<%- end -%>
<%- if @websocket_support %>
        if (req.http.upgrade ~ "(?i)websocket") {
            return (pipe);
        }
<%- end %>
        set req.http.X-Forwarded-Proto = "https";

<%- if @vcl_recv_extra -%>
    <%- @vcl_recv_extra.each_line do |line| -%>
        <%= line.chomp %>
    <%- end -%>
<%- end -%>
    }
}

<% if @websocket_support -%>
sub vcl_pipe {
    if (var.get("current-vhost") == "<%= @backend_name %>") {
        if (req.http.upgrade) {
            set bereq.http.upgrade = req.http.upgrade;
            set bereq.http.connection = req.http.connection;
        }
    }
}

<% end -%>
<% if @hsts_max_age or @vcl_deliver_extra -%>
sub vcl_deliver {
    if (var.get("current-vhost") == "<%= @backend_name %>") {
<% if @hsts_max_age -%>
        if (std.port(server.ip) != <%= scope['::profile::varnish::http_port'] %>) {
            set resp.http.Strict-Transport-Security = "max-age=<%= @hsts_max_age %>;";
        }
<% end -%>
<%- if @vcl_deliver_extra -%>
    <%- @vcl_deliver_extra.lines.each do |line| -%>
            <%= line %>
    <%- end -%>
<%- end -%>
    }
}

<%- if @basic_auth %>
sub vcl_synth {
    if (var.get("current-vhost") == "<%= @backend_name %>") {
        if (resp.status == 401) {
            set resp.http.WWW-Authenticate = "Basic";
            return(deliver);
        }
    }
}
<%- end %>
<% end -%>

