#!/bin/bash

set -e

CONFIG_DIR="<%= @config_dir %>"

if [ $# -lt 1 ]; then
    echo "usage: $0 PROFILE_NAME" >&2
    exit 2
fi

PROFILE="$1"
CONFIG_FILE="${CONFIG_DIR}/${PROFILE}.sh"

if ! [ -e "$CONFIG_FILE" ]; then
    echo "configuration file ${CONFIG_FILE} missing" >&2
    exit 2
fi

. "$CONFIG_FILE"

if [ -z "${ENDPOINT}" ] || [ -z "${SHARED_KEY}" ]; then
    echo "variables ENDPOINT and SHARED_KEY are mandatory" >&2
    exit 2
fi


curl_output="$(mktemp)"
exec 3>"$curl_output"
exec 4<"$curl_output"
rm -f "$curl_output"

if ! curl --fail --silent --show-error --location -F 'email=@-;type=message/rfc822' -F "shared_key=${SHARED_KEY}" "${ENDPOINT}" 2>&3 >&3; then
    # Print a temporary delivery failure status message so that postfix can retry the message later
    echo 4.3.0 temporary failure:
    cat <&4
    exit 1
fi
