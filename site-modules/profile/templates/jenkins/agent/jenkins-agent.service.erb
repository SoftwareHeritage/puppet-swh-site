[Unit]
Description=Jenkins agent
Documentation=https://wiki.jenkins.io/display/JENKINS/Distributed+builds
After=network.target

[Service]
ExecStart=/usr/bin/java -jar <%= @jenkins_agent_jar %> -jnlpUrl <%= @jnlp_url %> -secret @<%= @jnlp_secret_file %> -workDir <%= @workdir %>

User=jenkins
Group=jenkins

KillMode=process

Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
