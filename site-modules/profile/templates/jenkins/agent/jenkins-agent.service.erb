[Unit]
Description=Jenkins agent
Documentation=https://wiki.jenkins.io/display/JENKINS/Distributed+builds
After=network.target

[Service]
ExecStart=/usr/bin/java -jar <%= @jenkins_agent_jar %> -url <%= @jenkins_url %> -name <%= @jenkins_agent_name %> -secret @<%= @jnlp_secret_file %> -workDir <%= @workdir %> -tunnel <%= @jenkins_backend_tunnel %>

User=jenkins
Group=jenkins

KillMode=process

Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
