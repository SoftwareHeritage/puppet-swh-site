---
# File managed by puppet, changes will be lost.
actions:
  1:
    action: close
    description: >-

      Long and Intermediate Lifecycle Indices.

      Close indices older than <%= @long_intermediate_closing_delay %> days (based on index timestamp), for
      <% @long_intermediate_lifecycle_indices.each do |index| -%>
        - <%= index %>
      <% end -%>
      prefixed indices.
    options:
      skip_flush: False
      delete_aliases: False
      disable_action: False
      ignore_empty_list: True
    filters:
    - filtertype: pattern
      kind: regex
      value: '^(<%= @long_intermediate_lifecycle_indices.join('|') %>).*$'
    - filtertype: age
      source: field_stats
      direction: older
      unit: days
      unit_count: <%= @long_intermediate_closing_delay %>
      field: '@timestamp'
      stats_result: min_value
  2:
    action: close
    description: >-

      Short Lifecycle Indices.

      Close indices older than <%= @short_closing_delay %> days (based on index timestamp), for
      <% @short_lifecycle_indices.each do |index| -%>
        - <%= index %>
      <% end -%>
      prefixed indices.
    options:
      skip_flush: False
      delete_aliases: False
      disable_action: False
      ignore_empty_list: True
    filters:
    - filtertype: pattern
      kind: regex
      value: '^(<%= @short_lifecycle_indices.join('|') %>).*$'
    - filtertype: age
      source: field_stats
      direction: older
      unit: days
      unit_count: <%= @short_closing_delay %>
      field: '@timestamp'
      stats_result: min_value