---
# File managed by puppet, changes will be lost.
actions:
  1:
    action: close
    description: >-
      Close indices older than <%= @closing_delay %> days (based on index timestamp), for
      <% @all_indices.each do |index| -%>
        - <%= index %>
      <% end -%>
      prefixed indices.
    options:
      skip_flush: False
      delete_aliases: False
      disable_action: False
      ignore_empty_list: True
    filters:
    - filtertype: pattern
      kind: regex
      value: '^(<%= @all_indices.join('|') %>).*$'
    - filtertype: age
      source: field_stats
      direction: older
      unit: days
      unit_count: <%= @closing_delay %>
      field: '@timestamp'
      stats_result: min_value
