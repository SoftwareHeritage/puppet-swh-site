---
# File managed by puppet, changes will be lost.
actions:
  1:
    action: delete_indices
    description: >-

      Long Lifecycle Indices.

      Delete indices older than <%= @long_retention %> days (based on index creation date), for
      <% @long_lifecycle_indices.each do |index| -%>
        - <%= index %>
      <% end -%>
      prefixed indices. Ignore the error if the filter does not result in an
      actionable list of indices (ignore_empty_list) and exit cleanly.
    options:
      ignore_empty_list: True
      disable_action: False
    filters:
    - filtertype: pattern
      kind: regex
      value: '^(<%= @long_lifecycle_indices.join('|') %>).*$'
    - filtertype: age
      source: creation_date
      direction: older
      unit: days
      unit_count: <%= @long_retention %>
  2:
    action: delete_indices
    description: >-

      Intermediate Lifecycle Indices.

      Delete indices older than <%= @intermediate_retention %> days (based on index creation date), for
      <% @intermediate_lifecycle_indices.each do |index| -%>
        - <%= index %>
      <% end -%>
      prefixed indices. Ignore the error if the filter does not result in an
      actionable list of indices (ignore_empty_list) and exit cleanly.
    options:
      ignore_empty_list: True
      disable_action: False
    filters:
    - filtertype: pattern
      kind: regex
      value: '^(<%= @intermediate_lifecycle_indices.join('|') %>).*$'
    - filtertype: age
      source: creation_date
      direction: older
      unit: days
      unit_count: <%= @intermediate_retention %>
  3:
    action: delete_indices
    description: >-

      Short Lifecycle Indices.

      Delete indices older than <%= @short_retention %> days (based on index creation date), for
      <% @short_lifecycle_indices.each do |index| -%>
        - <%= index %>
      <% end -%>
      prefixed indices. Ignore the error if the filter does not result in an
      actionable list of indices (ignore_empty_list) and exit cleanly.
    options:
      ignore_empty_list: True
      disable_action: False
    filters:
    - filtertype: pattern
      kind: regex
      value: '^(<%= @short_lifecycle_indices.join('|') %>).*$'
    - filtertype: age
      source: creation_date
      direction: older
      unit: days
      unit_count: <%= @short_retention %>
