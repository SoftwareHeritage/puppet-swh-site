# Managed by puppet class profile::cassandra::instance
# Changes will be overwritten

[Unit]
Description=Cassandra paxos table specific repair
Requires=<%= @service_name %>
After=<%= @service_name %>

[Service]
User=<%= @cassandra_user %>
Group=<%= @cassandra_user %>
Type=simple
ExecStart=/opt/cassandra/bin/nodetool -u <%= @cassandra_user %> -pwf /etc/cassandra/jmxremote.password repair --paxos-only

[Install]
WantedBy=multi-user.target
